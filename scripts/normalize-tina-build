#!/usr/bin/env bash
set -euo pipefail

# Tina hashes its admin bundle during generation. Normalize the generated
# outputs so local and hosted verification compare only meaningful drift.
sleep 2
git restore -- \
	public/admin/.gitignore \
	public/admin/index.html \
  tina/__generated__/client.ts \
  tina/__generated__/types.js \
  tina/__generated__/types.ts
rm -rf tina/__generated__/.cache
