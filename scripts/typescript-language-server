#!/usr/bin/env bash
set -euo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
binary="$repo/node_modules/.bin/typescript-language-server"

if [[ ! -x "$binary" ]]; then
  echo "TypeScript language server is not installed. Run: dx bun install --frozen-lockfile" >&2
  exit 1
fi

exec "$binary" "$@"
