#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
search_path=":$PATH:"
search_path="${search_path//:$script_dir:/:}"
search_path="${search_path#:}"
search_path="${search_path%:}"
binary="$(PATH="$search_path" command -v cf || true)"

if [ -z "$binary" ]; then
	for candidate in "$script_dir/../.flox/run/"*/bin/cf; do
		if [ -x "$candidate" ] && [ "$candidate" != "$script_dir/cf" ]; then
			exec "$candidate" "$@"
		fi
	done
	echo "Cloudflare cf CLI is not on PATH. Run through dx/flox." >&2
	exit 1
fi

exec "$binary" "$@"
