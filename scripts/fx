#!/usr/bin/env bash
set -euo pipefail

export DIRENV_LOG_FORMAT=""
export QUIET=1

repo="${FLOX_ENV_PROJECT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"

if [ "${1:-}" = "-d" ] && [ -n "${2:-}" ]; then
  repo="$(realpath "$2")"
  shift 2
fi

usage() {
  cat <<'EOF'
Usage: fx [-d <path>] <command> [args]

Commands:
  install <pkg>   Install a Flox package or GitHub flake
  uninstall <pkg> Remove a Flox package
  run <command>   Run an arbitrary command through direnv exec .
  check           Run Astro check
  build           Run production build
  verify          Run the authoritative local/CI verification gate
  ci-local        Run the full GitHub CI job with act and rootless Podman
  ship            Verify, push, open a PR, and enable protected auto-merge
  deploy          Deploy dist to Cloudflare Pages
  ready           Show ready Seeds work
  smoke [base]    Smoke test localized routes and Tina admin labels
  help            Show this help
EOF
}

real_direnv="$(command -v direnv | grep -v "/scripts/direnv" | head -n 1 || echo direnv)"

dx() {
  "$real_direnv" exec "$repo" "$@"
}

cmd="${1:-help}"
case "$cmd" in
  run)
    shift
    if [ "$#" -eq 0 ]; then
      usage >&2
      exit 2
    fi
    exec "$real_direnv" exec "$repo" "$@"
    ;;
  install)
    shift
    if [ "$#" -eq 0 ]; then
      echo "Usage: fx install <package|flake>" >&2
      exit 2
    fi
    flox install -d "$repo" "$@"
    ;;
  uninstall)
    shift
    if [ "$#" -eq 0 ]; then
      echo "Usage: fx uninstall <package>" >&2
      exit 2
    fi
    flox remove -d "$repo" "$@"
    ;;
  check)
    dx bun run check
    ;;
  build)
    dx bun run build
    ;;
  verify)
    dx bun run verify:ci
    ;;
  ci-local)
    shift
    dx bun run test:workflow:ci -- "$@"
    ;;
  ship)
    dx bash scripts/ship
    ;;
  deploy)
    dx bun run deploy
    ;;
  ready)
    dx sd ready
    ;;
  smoke)
    base="${2:-${WIP_SITE_URL:-https://wip.senshac.com}}"
    dx bash -s -- "$base" <<'EOF'
set -euo pipefail

base="$1"
routes=(
  /
  /es/
  /es/studio/
  /es/methods/
  /es/works/la-trobada/
  /ca/
  /ca/studio/
  /ca/methods/
  /ca/works/la-trobada/
  /en/
  /en/studio/
  /en/methods/
  /en/works/la-trobada/
)

for path in "${routes[@]}"; do
  body="$(mktemp)"
  status="$(curl -LsS -o "$body" -w "%{http_code}" "$base$path")"
  title="$(rg -o "<title>[^<]+" "$body" | sed "s/<title>//" | head -1 || true)"
  rm -f "$body"
  printf "%s\t%s\t%s\n" "$path" "$status" "$title"
  [ "$status" = "200" ]
done

admin_html="$(mktemp)"
admin_js="$(mktemp)"
curl -LsS -o "$admin_html" "$base/admin/index.html"
asset="$(rg -o 'assets/index-[A-Za-z0-9._-]+\.js' "$admin_html" | head -1 || true)"
if [ -z "$asset" ]; then
  echo "admin asset missing" >&2
  exit 1
fi
curl -LsS -o "$admin_js" "$base/admin/$asset"
grep -Fq "Pages / Home" "$admin_js"
grep -Fq "Portfolio / Projects" "$admin_js"
if grep -Fq "Home (Spanish)" "$admin_js"; then
  echo "old Tina labels still present" >&2
  exit 1
fi
rm -f "$admin_html" "$admin_js"
echo "admin labels ok"
EOF
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "Unknown fx command: $cmd" >&2
    usage >&2
    exit 2
    ;;
esac
