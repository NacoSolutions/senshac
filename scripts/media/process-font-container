#!/usr/bin/env bash
set -euo pipefail

repo="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
runtime="${CONTAINER_RUNTIME:-podman}"
image="${MEDIA_RUNNER_IMAGE:-ghcr.io/nacosolutions/senshac-media-runner:latest}"
input="${1:-}"
output="${2:-}"

if [[ -z "$input" || -z "$output" ]]; then
  echo "usage: media:font <input.ttf|input.otf> <output.woff2>" >&2
  exit 2
fi

input="$(realpath "$input")"
output="$(realpath -m "$output")"
mkdir -p "$(dirname "$output")"

"$runtime" run --rm --userns=keep-id \
  -v "$repo:/repo:ro" \
  -v "$(dirname "$input"):/font-input:ro" \
  -v "$(dirname "$output"):/font-output:rw" \
  "$image" \
  bun /repo/scripts/media/process-font.ts \
  "/font-input/$(basename "$input")" \
  "/font-output/$(basename "$output")"
