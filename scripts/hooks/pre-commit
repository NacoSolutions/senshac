#!/usr/bin/env bash
set -euo pipefail

branch="$(git branch --show-current)"
if [[ "$branch" == "main" && "${SENSHAC_ALLOW_MAIN_COMMIT:-0}" != "1" ]]; then
  echo "Direct commits on main are disabled." >&2
  echo "Create a Seed worktree with:" >&2
  echo "  wt switch --create <kind>/<seed>-<slug> --base main" >&2
  echo "For exceptional repository maintenance only, set SENSHAC_ALLOW_MAIN_COMMIT=1." >&2
  exit 1
fi

if ! command -v betterleaks >/dev/null 2>&1; then
  echo "betterleaks is not on PATH. Run this commit from the Flox environment." >&2
  exit 1
fi

if git diff --cached --quiet --exit-code; then
  exit 0
fi

echo "Running betterleaks on staged changes..."
betterleaks git --staged --redact --no-banner --no-color --log-level warn .

echo "Running fast pre-commit gate..."
bun run check:precommit
