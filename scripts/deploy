#!/usr/bin/env bash
set -euo pipefail

git_common_dir="$(git rev-parse --path-format=absolute --git-common-dir)"
env_file="$(dirname "$git_common_dir")/.env.pages"

if [[ ! -f "$env_file" ]]; then
  echo "Missing centralized Pages environment: $env_file" >&2
  exit 1
fi

set -a
source "$env_file"
set +a

exec wrangler pages deploy dist --project-name senshac "$@"
