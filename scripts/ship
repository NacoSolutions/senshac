#!/usr/bin/env bash
set -euo pipefail

branch="$(git branch --show-current)"
if [[ -z "$branch" || "$branch" == "main" ]]; then
  echo "scripts/ship must run from a feature worktree branch." >&2
  exit 1
fi

if [[ -n "$(git status --porcelain)" ]]; then
  echo "Commit or remove working-tree changes before shipping." >&2
  exit 1
fi

git fetch origin --prune
if ! git merge-base --is-ancestor origin/main HEAD; then
  echo "Branch is behind origin/main. Rebase before shipping:" >&2
  echo "  git rebase origin/main" >&2
  exit 1
fi

repo="$(gh repo view --json nameWithOwner --jq .nameWithOwner)"
protection="$(gh api "repos/$repo/branches/main/protection" 2>/dev/null || true)"
if [[ -z "$protection" ]] || ! jq -e '
  .required_status_checks != null and
  .required_pull_request_reviews != null and
  .enforce_admins.enabled == true
' >/dev/null <<<"$protection"; then
  echo "GitHub main protection is missing or incomplete; refusing auto-merge." >&2
  echo "Require status checks, pull-request reviews, and admin enforcement before shipping." >&2
  exit 1
fi

git push --set-upstream origin HEAD

if pr_url="$(gh pr view --json url --jq .url 2>/dev/null)"; then
  echo "Using existing pull request: $pr_url"
else
  pr_url="$(gh pr create --base main --fill)"
  echo "Created pull request: $pr_url"
fi

gh pr merge "$pr_url" --auto --squash --delete-branch
echo "Auto-merge enabled: $pr_url"
