#!/usr/bin/env bash
set -euo pipefail

socket="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/podman/podman.sock"

if [[ ! -S "$socket" ]]; then
  systemctl --user start podman.socket
fi

export DOCKER_HOST="unix://${socket}"

git_common_dir="$(git rev-parse --path-format=absolute --git-common-dir)"
secret_file="$(dirname "$git_common_dir")/.secrets.act"

secret_args=()
if [[ -f "$secret_file" ]]; then
  secret_args=(--secret-file "$secret_file")
fi

act_args=(
  workflow_dispatch
  --workflows .github/workflows/process-media.yml
  "${secret_args[@]}"
  --job process
  --platform ubuntu-latest=ghcr.io/nacosolutions/senshac-media-processor@sha256:d070c3f6f98acb99d9f6f05060ffd69463c71e2ae1e422acafe0294580083dfe
  --container-daemon-socket -
  --container-architecture linux/amd64
  --pull=false
  --bind
)

# Only add smoke test eventpath if no input is provided
if [[ "$*" != *"--input"* ]]; then
  act_args+=(--eventpath .github/act/media-smoke.json)
fi

exec act "${act_args[@]}" "$@"
