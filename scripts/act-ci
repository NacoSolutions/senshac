#!/usr/bin/env bash
set -euo pipefail

socket="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/podman/podman.sock"

if [[ ! -S "$socket" ]]; then
  systemctl --user start podman.socket
fi

export DOCKER_HOST="unix://${socket}"

runner_image="${SENSHAC_RUNNER_IMAGE:-ghcr.io/nacosolutions/senshac-runner@sha256:e090a4d4aabe4573839584394f501c73a87ed36172690ca56a9a6f9edafa3f63}"
common_dir="$(git rev-parse --path-format=absolute --git-common-dir)"
head="$(git rev-parse HEAD)"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

git clone --no-hardlinks "$common_dir" "$tmp/repo" >/dev/null
git -C "$tmp/repo" checkout --detach "$head" >/dev/null
cd "$tmp/repo"

act pull_request \
  --workflows .github/workflows/ci.yml \
  --job ci \
  --platform "ubuntu-latest=${runner_image}" \
  --container-daemon-socket - \
  --container-architecture linux/amd64 \
  --pull=true \
  "$@"
