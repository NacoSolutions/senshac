{
	"entry": [
		"astro.config.mjs",
		"src/pages/**/*.astro",
		"src/pages/**/*.ts",
		"tina/config.ts",
		"scripts/acceptance/run.ts",
		"scripts/check-pages-routing.ts",
		"scripts/build",
		"scripts/act-media",
		"scripts/ci/prune-pages.ts",
		"scripts/media/*.ts",
		"scripts/media/*.sh",
		"scripts/with-timeout"
	],
	"project": [
		"astro.config.mjs",
		"src/**/*.astro",
		"src/**/*.ts",
		"tina/**/*.ts",
		"scripts/**/*.ts"
	],
	"ignore": [
		"astro.config.mjs",
		"tina/__generated__/**",
		"tina/config.ts",
		"scripts/acceptance/run.ts",
		"scripts/check-pages-routing.ts",
		"scripts/ci/prune-pages.ts",
		"scripts/media/stage-wordpress-media.ts",
		"scripts/media/sync-instagram.ts",
		"public/admin/**",
		"src/content/legal/**/*.mdx"
	],
	"ignoreBinaries": [
		"scripts/build",
		"scripts/act-media",
		"scripts/media/process-video.sh",
		"scripts/with-timeout",
		"betterleaks",
		"biome",
		"tinacms"
	],
	"ignoreDependencies": [
		"@astrojs/cloudflare",
		"@astrojs/mdx",
		"cloudflare",
		"esbuild",
		"next-tinacms-s3",
		"vite",
		"yaml"
	],
	"ignoreExportsUsedInFile": true,
	"astro": {
		"entry": ["src/pages/**/*.astro", "src/pages/**/*.ts"]
	},
	"workspaces": {
		"workers/media-dispatch": {
			"entry": ["src/index.ts"],
			"project": ["src/**/*.ts"]
		}
	}
}
